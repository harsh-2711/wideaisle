<!doctype html>
<html class="js">
  <head>
    <meta charset="utf-8">
    <title>{{ shop.name }}</title>
    <style>
      {%- for scheme in settings.color_schemes -%}
        {%- comment -%} Like Dawn: body text at 75% opacity, subtitles at 70%, headings solid. {%- endcomment -%}
        {%- assign text = scheme[1].settings.text -%}
        .color-{{ scheme[0] }} {
          --color-foreground: {{ text | color_extract: 'red' }},{{ text | color_extract: 'green' }},{{ text | color_extract: 'blue' }};
          color: rgba(var(--color-foreground), 0.75);
          background: {{ scheme[1].settings.background }};
        }
        .color-{{ scheme[0] }} h1, .color-{{ scheme[0] }} h2 { color: rgb(var(--color-foreground)); }
        .color-{{ scheme[0] }} .subtitle { color: rgba(var(--color-foreground), 0.7); }
        .color-{{ scheme[0] }} .button { color: {{ scheme[1].settings.button_label }}; background: {{ scheme[1].settings.button }}; }
      {%- endfor -%}
      body { margin: 0; font: 16px/1.5 sans-serif; }
      .button { display: inline-block; padding: 8px 16px; border: 0; }
      .icon { width: 20px; height: 20px; }
    </style>
  </head>
  <body class="color-scheme-1">
    {% section 'header' %}
    <main>
      {% section 'main-product' %}
      {% section 'newsletter' %}
    </main>
  </body>
</html>
