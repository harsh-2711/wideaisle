<section class="product">
  <h1>{{ product.title }}</h1>
  <p class="subtitle">{{ product.vendor }}</p>
  <img src="{{ product.featured_image | image_url: width: 400 }}" width="400" height="400">
  <p>{{ product.description }}</p>
  <form>
    <button name="minus" type="button">{% render 'icon-minus' %}</button>
    <input type="number" name="quantity" value="1">
    <button name="plus" type="button">{% render 'icon-plus' %}</button>
    <button type="submit" class="button">Add to cart</button>
  </form>
</section>
