# Copy to .env and fill in. Never commit .env.

# Postgres for the app, sessions and job queues (docker compose gives you this one).
DATABASE_URL=postgres://wideaisle:wideaisle@localhost:5432/wideaisle

# Set by `shopify app dev` from your Partner app. Only needed for `npm start`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_themes

# Run ledger (D-18): point at a clone of harsh-2711/wideaisle-ledger once it exists.
# WA_LEDGER_DIR=../wideaisle-ledger

# Status board sync (D-19).
# WA_PROJECT_TOKEN=
# WA_PROJECT_OWNER=harsh-2711
# WA_PROJECT_NUMBER=

# Alt text spike (M3 Spike C). Set a monthly spend limit on the key first (D-04).
# ANTHROPIC_API_KEY=

# Census crawler contact (M2), shown in its user agent.
# CENSUS_CONTACT=
