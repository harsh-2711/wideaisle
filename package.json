{
  "name": "wideaisle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "board": "node scripts/agents/board.mjs",
    "build": "react-router build",
    "commitlint": "commitlint",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:up": "docker compose up -d db",
    "deploy": "shopify app deploy",
    "dev": "shopify app dev",
    "docker-start": "npm run setup && npm run start",
    "env": "shopify app env",
    "generate": "shopify app generate",
    "graphql-codegen": "graphql-codegen",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "prepare": "husky || true",
    "setup": "node scripts/migrate.mjs",
    "shopify": "shopify",
    "start": "react-router-serve ./build/server/index.js",
    "test": "npm run test:unit && npm run test:agents",
    "test:a11y": "playwright test",
    "test:agents": "node --test 'scripts/agents/*.test.mjs' 'scripts/ci/*.test.mjs' '.claude/hooks/*.test.mjs'",
    "test:unit": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "vite": "vite"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.1.31",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@shopify/shopify-api": "^15.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  }
}
